---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

interface ContactLink {
  platform: string;
  handle: string;
  href: string;
  icon: string;
  description: string;
  isExternal: boolean;
}

const contactLinks: ContactLink[] = [
  {
    platform: 'Email',
    handle: 'hello@mahimsafa.com',
    href: 'mailto:hello@mahimsafa.com',
    icon: 'bi:envelope-fill',
    description: 'Best for project inquiries',
    isExternal: false,
  },
  {
    platform: 'LinkedIn',
    handle: 'linkedin.com/in/mahimsafa',
    href: 'https://www.linkedin.com/in/mahimsafa/',
    icon: 'bi:linkedin',
    description: 'Connect professionally',
    isExternal: true,
  },
  {
    platform: 'GitHub',
    handle: 'github.com/mahimsafa',
    href: 'https://github.com/mahimsafa',
    icon: 'bi:github',
    description: 'See my open-source work',
    isExternal: true,
  },
  {
    platform: 'Twitter / X',
    handle: '@mahim_safa',
    href: 'https://twitter.com/mahim_safa',
    icon: 'bi:twitter-x',
    description: 'Thoughts and updates',
    isExternal: true,
  },
  {
    platform: 'Fiverr',
    handle: 'fiverr.com/mahimsafa',
    href: 'https://www.fiverr.com/mahimsafa',
    icon: 'bi:bag-fill',
    description: 'Hire me for freelance work',
    isExternal: true,
  },
];
---

<Layout
  title="Hire Me"
  description="Get in touch with Mahim Safa for AWS consulting, DevOps engineering, full-stack development, and AI integration projects."
>
  <section class="mx-auto my-12 flex w-full max-w-2xl flex-col items-start px-2">
    <!-- Heading -->
    <div class="mb-8">
      <p class="mb-2 font-display text-sm uppercase tracking-widest text-rust">
        // available for work
      </p>
      <h1 class="font-display text-3xl leading-tight text-ink sm:text-4xl">
        Let's Build Something<br />
        <span class="text-rust">Together</span>
      </h1>
      <hr class="rule-handdrawn mt-4 w-48" aria-hidden="true" />
    </div>

    <!-- Intro paragraph -->
    <p class="mb-10 max-w-prose font-mono text-base leading-relaxed text-ink-soft">
      I'm currently available for freelance projects, consulting, and full-time opportunities.
      Whether you need a new product built from scratch, a codebase untangled, or a reliable
      engineer on your team — feel free to reach out through any of the channels below.
    </p>

    <!-- Contact cards grid -->
    <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
      {
        contactLinks.map((link) => (
          <a
            href={link.href}
            aria-label={`${link.platform}: ${link.handle}`}
            {...(link.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="paper-card group flex items-start gap-4 rounded-sm border border-paper-edge bg-paper-deep/50 p-5"
          >
            <div class="mt-0.5 shrink-0">
              <Icon
                name={link.icon}
                class="h-6 w-6 text-ink-soft transition-colors duration-200 group-hover:text-rust"
              />
            </div>
            <div class="flex min-w-0 flex-col">
              <span class="mb-0.5 font-display text-xs uppercase tracking-widest text-rust">
                {link.platform}
              </span>
              <span class="truncate font-mono text-sm font-medium text-ink">
                {link.handle}
              </span>
              <span class="mt-0.5 font-mono text-xs text-ink-soft">
                {link.description}
              </span>
            </div>
            {link.isExternal && (
              <Icon
                name="bi:arrow-up-right"
                class="ml-auto mt-0.5 h-4 w-4 shrink-0 text-ink-soft/60 transition-colors duration-200 group-hover:text-rust"
              />
            )}
          </a>
        ))
      }
    </div>
  </section>
</Layout>
