---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

const posts = await getCollection('blog');
---

<Layout
  title="Blog"
  description="Technical articles on AWS architecture, DevOps practices, MongoDB, and full-stack development by Mahim Safa."
>
  <div class="mx-auto my-10 flex w-full max-w-3xl flex-col gap-6 pb-5">
    {
      posts.map((item) => (
        <a
          href={`/article/${item.id}`}
          class="paper-card group flex flex-col gap-4 rounded-sm border border-paper-edge bg-paper-deep/50 p-5 sm:flex-row sm:items-start"
        >
          <img
            src={item.data.cover}
            alt={item.data.title}
            width={250}
            height={167}
            loading="lazy"
            class="w-full rounded-sm border border-paper-edge object-cover sepia-[0.25] sm:w-48"
          />
          <div class="flex min-w-0 flex-col">
            <h2 class="font-display text-xl leading-snug text-ink transition-colors duration-150 group-hover:text-rust">
              {item.data.title}
            </h2>
            <p class="mt-1 font-display text-xs text-ink-soft">
              {format(item.data.date, 'PPPP')}
            </p>
            <p class="mt-3 font-mono text-sm leading-relaxed text-ink-soft">
              {item.body?.slice(0, 180).replace(/#/g, '').trim()}&hellip;
            </p>
            <span class="mt-3 font-mono text-xs text-rust transition-colors duration-150 group-hover:text-rust-bright">
              Read the entry &rarr;
            </span>
          </div>
        </a>
      ))
    }
  </div>
</Layout>
