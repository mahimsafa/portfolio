---
import Layout from '../layouts/Layout.astro';
import Stamp from '../components/Stamp.astro';
---

<Layout title="404 — Not Found" description="The page you're looking for doesn't exist.">
  <div class="mx-auto my-12 w-full max-w-lg rounded-sm border-2 border-paper-edge bg-paper-deep/60 p-8 text-center shadow-[4px_4px_0_0_rgba(51,41,29,0.2)] sm:p-12">
    <div class="mb-6 flex justify-center">
      <Stamp label="Missing" />
    </div>
    <p class="mb-2 font-display text-sm uppercase tracking-widest text-rust">Error 404</p>
    <h1 class="mb-4 font-display text-4xl text-ink md:text-5xl">
      Page not found
    </h1>
    <hr class="rule-handdrawn mx-auto mb-6 w-40" aria-hidden="true" />
    <p class="mb-8 font-mono text-sm leading-relaxed text-ink-soft">
      Looks like this route doesn't exist. Maybe it was moved, deleted, or you typed the URL
      incorrectly.
    </p>
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/"
        class="rounded-sm border border-paper-edge bg-rust px-5 py-2.5 font-mono text-sm font-medium text-paper transition-colors duration-200 hover:bg-rust-bright"
      >
        Go Home
      </a>
      <a
        href="/blog"
        class="rounded-sm border border-paper-edge bg-paper px-5 py-2.5 font-mono text-sm font-medium text-ink transition-colors duration-200 hover:border-rust hover:text-rust"
      >
        Read Blog
      </a>
    </div>
  </div>
</Layout>
