---
import { Icon } from 'astro-icon/components';
import { sections } from '../content/data';

const isHomePage = Astro.url.pathname === '/';

const keptSections = sections.filter((section) =>
  ['about', 'experience', 'clients'].includes(section.id)
);

const mobileItems = [
  ...keptSections.map((section) => ({
    ...section,
    href: isHomePage ? `#${section.id}` : `/#${section.id}`,
    isSection: true,
  })),
  { id: 'blog', label: 'Blog', icon: 'bi:journal-text', href: '/blog', isSection: false },
  {
    id: 'contact',
    label: 'Contact',
    icon: 'bi:envelope',
    href: isHomePage ? '#contact' : '/#contact',
    isSection: true,
  },
];
---

<nav
  id="mobile-nav"
  class="fixed bottom-0 left-0 right-0 z-50 flex h-16 items-center justify-around border-t border-paper-edge bg-paper/95 backdrop-blur-sm lg:hidden"
  aria-label="Mobile section navigation"
>
  {
    mobileItems.map((item) => (
      <a
        href={item.href}
        class="flex flex-col items-center justify-center gap-1 px-3 py-2 text-ink-soft transition-colors duration-150 hover:text-rust"
        aria-label={item.isSection ? `Go to ${item.label} section` : `Go to ${item.label} page`}
        data-mobile-section={item.isSection ? item.id : undefined}
      >
        <Icon name={item.icon} class="h-5 w-5" />
        <span class="text-[10px] font-medium">{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  [data-mobile-section].active {
    @apply text-rust;
  }
</style>

<script>
  const mobileNav = document.getElementById('mobile-nav');
  const mobileLinks = mobileNav?.querySelectorAll('a[data-mobile-section]');
  const mobileSectionIds = Array.from(mobileLinks || []).map((link) =>
    link.getAttribute('data-mobile-section')
  );

  const mobileObserverOptions = {
    root: null,
    rootMargin: '-30% 0px -60% 0px',
    threshold: 0,
  };

  const mobileObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        mobileLinks?.forEach((link) => {
          link.classList.toggle('active', link.getAttribute('data-mobile-section') === id);
        });
      }
    });
  }, mobileObserverOptions);

  mobileSectionIds.forEach((id) => {
    const section = document.getElementById(id!);
    if (section) mobileObserver.observe(section);
  });
</script>
