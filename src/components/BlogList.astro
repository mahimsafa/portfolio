---
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<section id="blog" class="w-full py-16" data-animate>
  <h2 class="section-heading mb-4 text-center font-display text-2xl text-ink sm:text-3xl">
    Latest Articles
  </h2>
  <p class="mb-12 text-center font-mono text-sm text-ink-soft">
    Thoughts on development, cloud, and security
  </p>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      posts.map((post) => (
          <a
            href={`/article/${post.id}`}
            class="paper-card group flex flex-col rounded-sm border border-paper-edge bg-paper-deep/50 p-5"
          >
            <h3 class="mb-2 font-display text-lg leading-snug text-ink transition-colors duration-150 group-hover:text-rust">
              {post.data.title}
            </h3>
            <div class="mb-3 flex flex-wrap gap-1">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-sm border border-paper-edge bg-paper px-2 py-0.5 font-mono text-xs text-ink-soft">
                  {tag}
                </span>
              ))}
            </div>
            <p class="mt-auto flex items-center justify-between font-mono text-xs text-ink-soft">
              <span>{format(post.data.date, 'MMM d, yyyy')}</span>
              <span class="text-rust transition-colors duration-150 group-hover:text-rust-bright">
                Read &rarr;
              </span>
            </p>
          </a>
      ))
    }
  </div>
</section>
