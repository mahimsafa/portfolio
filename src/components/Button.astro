---
import { Icon } from 'astro-icon/components';
---

<button
  class="group mt-5 flex items-center justify-center rounded-sm border border-paper-edge bg-paper-deep px-3 py-2 font-mono text-ink shadow-[2px_2px_0_0_rgba(51,41,29,0.3)] transition-colors duration-200 ease-in hover:bg-rust hover:text-paper active:translate-y-0.5 active:shadow-none"
  onclick="share()"
  onmouseout="outFunc()"
  >Share
  <span
    class="absolute -mt-20 hidden rounded-sm border border-paper-edge bg-paper-deep px-4 py-2 text-ink transition-all duration-200 ease-in-out group-hover:block"
    id="tooltip">Copy to clipboard</span
  >
  <Icon
    name="share"
    width="20"
    class="ml-2 transition-colors duration-200 ease-in group-hover:fill-paper"
  />
</button>

<script is:inline>
  function share() {
    const sharecontent = `${document.title}\n${window.location.href}`;
    navigator.clipboard.writeText(sharecontent);

    const tooltip = document.getElementById('tooltip');
    tooltip.innerHTML = "<b class='text-rust'>Copied: </b> " + sharecontent;
  }
  function outFunc() {
    const tooltip = document.getElementById('tooltip');
    tooltip.innerHTML = 'Copy to clipboard';
  }
</script>
