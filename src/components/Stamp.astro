---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<span
  class:list={['stamp', className]}
  aria-hidden="true"
>
  {label}
</span>

<style>
  .stamp {
    display: inline-block;
    pointer-events: none;
    user-select: none;
    padding: 0.35rem 0.9rem;
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7d3a30;
    border: 2px solid #7d3a30;
    box-shadow: inset 0 0 0 3px #f1e9d4, inset 0 0 0 4px #7d3a30;
    border-radius: 4px;
    transform: rotate(-2deg);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }
</style>
